<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetNet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="5G"
            android:textColor="@color/widget_badge_text"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetCarrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="F50 · 中国移动"
            android:textColor="@color/widget_carrier"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓ 0B"
            android:textColor="@color/widget_down"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="↑ 0B"
            android:textColor="@color/widget_up"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetFoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="剩余 88.65 GB · 今日 0 MB"
        android:textColor="@color/widget_foot"
        android:textSize="10sp" />
</LinearLayout>
